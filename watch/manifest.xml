<?xml version="1.0" encoding="UTF-8"?><!--Remote Shutter - Connect IQ watch app.The application id below is what ties the watch app to the Androidcompanion app. It MUST stay in sync with CiqLink.APP_UUID in theAndroid sources. It is an arbitrary, unique 32-hex-char string; it isnot registered anywhere because we are not publishing to the store.The product list matches the API-3.4 device group that the Connect IQSDK Manager downloads (all 23 of them). Keeping the list in sync with~/.Garmin/ConnectIQ/Devices/ avoids "Invalid device id found in theapplication manifest" warnings.--><iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application entry="ShutterApp"
                    id="a4d0bb18b083423f9197ac0c746a3b65"
                    launcherIcon="@Drawables.LauncherIcon"
                    minSdkVersion="3.4.0"
                    name="@Strings.AppName"
                    type="watch-app">

        <!-- "Communications" is the permission that grants access to the
             Bluetooth Low Energy link to the phone, i.e. to
             Communications.transmit() and registerForPhoneAppMessages(). -->
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>

        <iq:products>
            <iq:product id="instinct2"/>
            <iq:product id="instinct2s"/>
            <iq:product id="instinct2x"/>
            <iq:product id="instinctcrossover"/>
            <iq:product id="fenix6"/>
            <iq:product id="fenix6pro"/>
            <iq:product id="fenix6s"/>
            <iq:product id="fenix6spro"/>
            <iq:product id="fenix6xpro"/>
            <iq:product id="fr55"/>
            <iq:product id="fr945lte"/>
            <iq:product id="enduro"/>
            <iq:product id="descentg1"/>
            <iq:product id="descentmk2"/>
            <iq:product id="descentmk2s"/>
            <iq:product id="marqadventurer"/>
            <iq:product id="marqathlete"/>
            <iq:product id="marqaviator"/>
            <iq:product id="marqcaptain"/>
            <iq:product id="marqcommander"/>
            <iq:product id="marqdriver"/>
            <iq:product id="marqexpedition"/>
            <iq:product id="marqgolfer"/>
        </iq:products>
    </iq:application>
</iq:manifest>
